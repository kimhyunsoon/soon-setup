#!/usr/bin/env python3
# 한글/영어 타자연습 CLI
# Enter 다음 문장 · Backspace 수정 · Ctrl+U 줄 지움 · ESC/Ctrl+C 종료
import codecs
import os
import random
import sys
import termios
import time
import tty

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
FILES = {"1": "sentences_kr.tsv", "2": "sentences_en.tsv"}

# 두벌식에서 2타인 중성 인덱스: ㅘ ㅙ ㅚ ㅝ ㅞ ㅟ ㅢ
DOUBLE_JUNG = {9, 10, 11, 14, 15, 16, 19}
# 두벌식에서 2타인 종성 인덱스: ㄳ ㄵ ㄶ ㄺ ㄻ ㄼ ㄽ ㄾ ㄿ ㅀ ㅄ
DOUBLE_JONG = {3, 5, 6, 9, 10, 11, 12, 13, 14, 15, 18}

GREEN = "\x1b[32m"
RED = "\x1b[31m"
RED_BG = "\x1b[41m"
DIM = "\x1b[2m"
RESET = "\x1b[0m"


# 한 글자를 두벌식 기준 타수로 환산
def char_strokes(ch: str) -> int:
    code = ord(ch)
    if not 0xAC00 <= code <= 0xD7A3:
        return 1
    offset = code - 0xAC00
    jung = offset % 588 // 28
    jong = offset % 28
    strokes = 1 + (2 if jung in DOUBLE_JUNG else 1)
    if jong:
        strokes += 2 if jong in DOUBLE_JONG else 1
    return strokes


# 정타(예시문장과 일치하는 글자)만 타수로 계산
def correct_strokes(typed: str, example: str) -> int:
    return sum(
        char_strokes(c)
        for i, c in enumerate(typed)
        if i < len(example) and c == example[i]
    )


# tsv 한 줄: 문장<TAB>작품명<TAB>연도<TAB>작가·감독·등장인물
def load_sentences(filename: str) -> list[tuple[str, str]]:
    items: list[tuple[str, str]] = []
    with open(os.path.join(BASE_DIR, filename), encoding="utf-8") as f:
        for line in f:
            parts = [p.strip() for p in line.rstrip("\n").split("\t")]
            if not parts[0]:
                continue
            work = parts[1] if len(parts) > 1 else ""
            year = parts[2] if len(parts) > 2 else ""
            person = parts[3] if len(parts) > 3 else ""
            source = f"{person} · {work}" if person else work
            if year:
                source += f", {year}"
            items.append((parts[0], source))
    return items


def correct_count(typed: str, example: str) -> int:
    return sum(1 for i, c in enumerate(typed) if i < len(example) and c == example[i])


def render(
    round_no: int,
    example: str,
    source: str,
    typed: str,
    first_t: float,
    last_t: float,
    first_strokes: int,
    agg: dict,
) -> None:
    # 첫 입력 이전의 시간은 알 수 없으므로 첫 입력분 타수는 제외하고 계산
    elapsed = last_t - first_t
    strokes = max(0, correct_strokes(typed, example) - first_strokes)
    cur_speed = min(5000, strokes * 60 / elapsed) if typed and elapsed > 0 else 0
    avg_speed = min(5000, agg["strokes"] * 60 / agg["secs"]) if agg["secs"] > 0 else 0
    total_correct = agg["correct"] + correct_count(typed, example)
    total_typed = agg["typed"] + len(typed)
    acc = total_correct / total_typed * 100 if total_typed else 100
    colored: list[str] = []
    for i, c in enumerate(typed):
        if i < len(example) and c == example[i]:
            colored.append(GREEN + c)
        elif c == " ":
            colored.append(RED_BG + " " + RESET)
        else:
            colored.append(RED + c)
    sep = f" {DIM}·{RESET} "
    sys.stdout.write(
        "\x1b[H"
        + f"{round_no}{sep}현재{cur_speed:.0f}{sep}평균{avg_speed:.0f}{sep}{acc:.0f}%\x1b[K\n"
        + "\x1b[K\n"
        + f"{DIM}{source}{RESET}\x1b[K\n"
        + example + "\x1b[K\n"
        + "\x1b[K\n"
        + "".join(colored) + RESET + "\x1b[K\x1b7\n\x1b[J\x1b8"
    )
    sys.stdout.flush()


LOGO = r"""
 _
| |_ _   _ _ __   ___
| __| | | | '_ \ / _ \
| |_| |_| | |_) | (_) |
 \__|\__, | .__/ \___/
     |___/|_|
"""


def pick_language(fd: int) -> str | None:
    sys.stdout.write("\x1b[H\x1b[2J" + LOGO + "\n1. 한국어\n2. English\n")
    sys.stdout.flush()
    while True:
        for byte in os.read(fd, 64):
            ch = chr(byte)
            if ch in FILES:
                return FILES[ch]
            if ch in ("\x03", "\x04", "\x1b"):
                return None


def practice(fd: int, sentences: list[tuple[str, str]], agg: dict) -> None:
    order = list(range(len(sentences)))
    random.shuffle(order)
    idx = 0
    round_no = 1
    typed = ""
    first_t = last_t = 0.0
    first_strokes = 0
    decoder = codecs.getincrementaldecoder("utf-8")("ignore")
    example, source = sentences[order[idx]]
    sys.stdout.write("\x1b[2J")
    render(round_no, example, source, typed, first_t, last_t, first_strokes, agg)
    while True:
        data = os.read(fd, 4096)
        # ESC 단독 입력은 종료, 이스케이프 시퀀스(방향키 등)는 무시
        if not data or data == b"\x1b":
            return
        esc = 0
        for ch in decoder.decode(data):
            if esc == 1:
                esc = 2 if ch in "[O" else 0
                continue
            if esc == 2:
                if not (ch.isdigit() or ch == ";"):
                    esc = 0
                continue
            if ch == "\x1b":
                esc = 1
            elif ch in "\r\n":
                if typed:
                    agg["strokes"] += max(0, correct_strokes(typed, example) - first_strokes)
                    agg["secs"] += last_t - first_t
                    agg["correct"] += correct_count(typed, example)
                    agg["typed"] += len(typed)
                    agg["recorded"] += 1
                round_no += 1
                idx += 1
                if idx >= len(order):
                    random.shuffle(order)
                    idx = 0
                example, source = sentences[order[idx]]
                typed = ""
                first_t = last_t = 0.0
                first_strokes = 0
            elif ch in "\x7f\x08":
                typed = typed[:-1]
                if not typed:
                    first_t = last_t = 0.0
                    first_strokes = 0
            elif ch == "\x15":
                typed = ""
                first_t = last_t = 0.0
                first_strokes = 0
            elif ch in "\x03\x04":
                return
            elif ord(ch) >= 32:
                now = time.monotonic()
                if first_t == 0:
                    first_t = now
                    first_strokes = char_strokes(ch) if example and ch == example[0] else 0
                last_t = now
                typed += ch
        render(round_no, example, source, typed, first_t, last_t, first_strokes, agg)


def main() -> None:
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    agg = {"strokes": 0, "secs": 0.0, "correct": 0, "typed": 0, "recorded": 0}
    error = ""
    sys.stdout.write("\x1b[?1049h")
    try:
        tty.setcbreak(fd)
        filename = pick_language(fd)
        if filename:
            try:
                sentences = load_sentences(filename)
            except OSError:
                sentences = []
            if sentences:
                practice(fd, sentences, agg)
            else:
                error = f"{filename} 파일이 없거나 비어있습니다."
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write(RESET + "\x1b[?1049l")
        sys.stdout.flush()
    if error:
        print(error)
    elif agg["recorded"]:
        avg_speed = min(5000, agg["strokes"] * 60 / agg["secs"]) if agg["secs"] > 0 else 0
        avg_acc = agg["correct"] / agg["typed"] * 100 if agg["typed"] else 0
        print(f"{agg['recorded']}회 기록 · 평균 {avg_speed:.0f}타 · 정확도 {avg_acc:.1f}%")


if __name__ == "__main__":
    main()
